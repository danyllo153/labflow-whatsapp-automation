          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const dropsRows = $('Get rows DROPS').all();\n\nconst hoje = new Date();\nconst hojeStr = hoje.toLocaleDateString('pt-BR');\n\nconst dropsHoje = dropsRows.filter(item => {\n  const data = item.json['DATA PREVISTA'];\n  const status = (item.json['STATUS'] || '').trim().toLowerCase();\n  return data === hojeStr && status !== 'concluido' && status !== 'concluído';\n});\n\nconst grupos = {};\ndropsHoje.forEach(item => {\n  const dia = item.json['DIA DROP'];\n  const tanque = item.json['TANQUE'];\n  const tipoTanque = (item.json['TIPO TANQUE'] || '').trim().toLowerCase();\n  const navio = item.json['NAVIO'];\n\n  if (!grupos[dia]) grupos[dia] = { terra: [], navios: {} };\n\n  if (tipoTanque === 'navio' && navio) {\n    (grupos[dia].navios[navio] ??= []).push(tanque);\n  } else {\n    grupos[dia].terra.push(tanque);\n  }\n});\n\nconst ordem = ['D5', 'D10', 'D15'];\nconst linhas = ordem\n  .filter(dia => grupos[dia])\n  .map(dia => {\n    const g = grupos[dia];\n    const partes = [...g.terra];\n    Object.entries(g.navios).forEach(([nome, tanques]) => {\n      partes.push(`${tanques.join(',')}  NAVIO ${nome}`);\n    });\n    const diasNum = parseInt(dia.replace('D', ''), 10);\n    const dataColeta = new Date(hoje);\n    dataColeta.setDate(dataColeta.getDate() - diasNum);\n    return `${dia} -  Tanques ${partes.join(', ')} - coletados ${dataColeta.toLocaleDateString('pt-BR')}`;\n  });\n\nconst texto = linhas.length\n  ? linhas.join('\\n')\n  : `Nenhum drop previsto para hoje (${hojeStr}).`;\n\nreturn [{ json: { textoResposta: texto } }];"
      },
