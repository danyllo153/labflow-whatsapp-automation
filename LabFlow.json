    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json.body.data;\n\nif (data.key?.fromMe === true) {\n  return null;\n}\n\nconst msgTimestamp = data.messageTimestamp;\nconst nowSeconds = Math.floor(Date.now() / 1000);\nconst MAX_AGE_SECONDS = 600;\nif (msgTimestamp && (nowSeconds - msgTimestamp) > MAX_AGE_SECONDS) {\n  return null;\n}\n\nconst texto = data.message.conversation;\nconst numeroRemetente = data.key.remoteJid;\nconst nomeContato = data.pushName || 'Desconhecido';\n\n// Calcula as 3 datas de drop (D5, D10, D15) a partir da data de coleta\nfunction calcularDrops(dataColetaStr, idColeta, tanque, tipoTanque, navio) {\n  const [dia, mes, ano] = dataColetaStr.split('/').map(Number);\n  const dataBase = new Date(ano, mes - 1, dia);\n  const dias = [5, 10, 15];\n  return dias.map(offset => {\n    const dataDrop = new Date(dataBase);\n    dataDrop.setDate(dataDrop.getDate() + offset);\n    const dd = String(dataDrop.getDate()).padStart(2, '0');\n    const mm = String(dataDrop.getMonth() + 1).padStart(2, '0');\n    const yyyy = dataDrop.getFullYear();\n    return {\n      idDrop: `DR-${idColeta}-${offset}`,\n      idColeta: idColeta,\n      tipoTanque: tipoTanque,\n      tanque: tanque,\n      navio: navio || '',\n      diaDrop: `D${offset}`,\n      dataPrevista: `${dd}/${mm}/${yyyy}`,\n      status: 'Pendente',\n      responsavel: nomeContato\n    };\n  });\n}\n\n// --- COLETA TANQUE TERRA ---\nif (/registrar coleta tanque terra/i.test(texto)) {\n  const matchTanque = texto.match(/tanque terra\\s+(\\d+)/i);\n  const matchData = texto.match(/(\\d{2}\\/\\d{2}\\/\\d{4})/);\n\n  const tanque = matchTanque ? matchTanque[1] : null;\n  const dataColeta = matchData ? matchData[1] : null;\n  const idColeta = `CT-${Date.now()}`;\n\n  const drops = (tanque && dataColeta)\n    ? calcularDrops(dataColeta, idColeta, tanque, 'Terra', null)\n    : [];\n\n  return {\n    json: {\n      tipo: 'coleta_terra',\n      idColeta,\n      tanque,\n      dataColeta,\n      numero: numeroRemetente,\n      nomeContato,\n      drops\n    }\n  };\n}\n\n// --- COLETA TANQUE NAVIO ---\nif (/coleta navio/i.test(texto)) {\n  const matchNavio = texto.match(/coleta\\s+navio\\s+(.+?)\\s+tanques\\s+([a-z0-9,\\s]+?)\\s+data\\s+(\\d{2}\\/\\d{2}\\/\\d{4})/i);\n\n  if (matchNavio) {\n    const navio = matchNavio[1].trim();\n    const tanques = matchNavio[2].split(',').map(t => t.trim().toUpperCase()).filter(Boolean);\n    const dataColeta = matchNavio[3];\n\n    const itensColeta = [];\n    let drops = [];\n\n    tanques.forEach((tanque, idx) => {\n      const idColeta = `CN-${Date.now()}-${idx}`;\n\n      itensColeta.push({\n        idColeta,\n        navio,\n        tanque,\n        dataColeta,\n        responsavel: nomeContato\n      });\n\n      drops = drops.concat(\n        calcularDrops(dataColeta, idColeta, tanque, 'Navio', navio)\n      );\n    });\n\n    return {\n      json: {\n        tipo: 'coleta_navio',\n        navio,\n        dataColeta,\n        tanques,\n        itensColeta,\n        drops,\n        numero: numeroRemetente,\n        nomeContato,\n        textoResposta:\n          `✅ Coleta registrada.\\n\\nNavio: ${navio}\\n` +\n          `Tanques: ${tanques.join(', ')}\\n` +\n          `Data: ${dataColeta}\\n` +\n          `Total: ${tanques.length} tanque${tanques.length === 1 ? '' : 's'}`\n      }\n    };\n  }\n}\n\n// --- CONSULTA DE DROPS ---\nif (/^drops?\\s*(previstos)?\\s*(para)?\\s*hoje\\??$/i.test(texto.trim())) {\n  return {\n    json: {\n      tipo: 'consulta_drops',\n      numero: numeroRemetente,\n      nomeContato\n    }\n  };\n}\n\n// --- AMOSTRA (fluxo existente, sem mudança) ---\nconst regexAmostra = /amostra\\s+(\\d+)/i;\nconst regexAnalise = /analise\\s+([a-zA-ZÀ-ú]+)/i;\nconst regexData = /(\\d{2}\\/\\d{2}\\/\\d{4})/;\n\nconst matchAmostra = texto.match(regexAmostra);\nconst matchAnalise = texto.match(regexAnalise);\nconst matchData = texto.match(regexData);\n\nreturn {\n  json: {\n    tipo: 'amostra',\n    idRegistro: `AM-${Date.now()}`,\n    amostra: matchAmostra ? matchAmostra[1] : null,\n    analise: matchAnalise ? matchAnalise[1] : null,\n    data: matchData ? matchData[1] : null,\n    mensagem_original: texto,\n    numero: numeroRemetente,\n    nomeContato: nomeContato\n  }\n};"
      },
