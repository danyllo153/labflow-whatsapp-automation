                                   ],
                      "id":  "73773df1-5759-4309-8a27-c322f66445f4",
                      "name":  "BD · Buscar Admins",
                      "alwaysOutputData":  true,
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "POSTGRES_CREDENTIAL_ID",
                                                           "name":  "Postgres LabFlow"
                                                       }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Monta o alerta de erro para os Admins.\n// Nunca inclui o texto das mensagens dos usuarios: so workflow, node, erro (sem numeros longos),\n// execucao e hora.\nconst dados = $(\u0027Error Trigger\u0027).first().json;\nconst wf = dados.workflow || {};\nconst ex = dados.execution || {};\nconst erro = ex.error || {};\n\n// Tira quebras de linha e mascara sequencias de 8+ digitos (telefone que o banco cita no erro).\nconst limpar = (s) =\u003e String(s || \u0027\u0027).replace(/\\d{8,}/g, \u0027***\u0027).replace(/\\s+/g, \u0027 \u0027).trim();\n\nconst nodeDoErro = erro.node \u0026\u0026 typeof erro.node === \u0027object\u0027 ? erro.node.name : erro.node;\nconst nodeFalhou = limpar(ex.lastNodeExecuted || nodeDoErro || \u0027desconhecido\u0027);\nconst mensagem = limpar(erro.message || \u0027sem mensagem\u0027).slice(0, 300);\nconst nomeWorkflow = limpar(wf.name || \u0027desconhecido\u0027);\n\n// Quem recebe: todos os Admins cadastrados (vem do node anterior).\nconst admins = $input.all()\n  .map((i) =\u003e String(i.json.telefone || \u0027\u0027).replace(/\\D/g, \u0027\u0027))\n  .filter(Boolean);\nif (admins.length === 0) return [];\n\n// Evita enxurrada: o mesmo erro, no mesmo node, so alerta de novo depois de 10 minutos.\nconst JANELA_MS = 10 * 60 * 1000;\nconst agoraMs = Date.now();\nconst memoria = $getWorkflowStaticData(\u0027global\u0027);\nconst recentes = memoria.alertasRecentes || {};\nfor (const chave of Object.keys(recentes)) {\n  if (agoraMs - recentes[chave] \u003e JANELA_MS) delete recentes[chave];\n}\nconst chaveErro = `${nomeWorkflow}|${nodeFalhou}|${mensagem}`;\nif (recentes[chaveErro]) {\n  memoria.alertasRecentes = recentes;\n  return [];\n}\nrecentes[chaveErro] = agoraMs;\nmemoria.alertasRecentes = recentes;\n\nconst hora = new Date().toLocaleString(\u0027pt-BR\u0027, { timeZone: \u0027America/Sao_Paulo\u0027 });\nconst texto = [\n  \u0027🚨 LabFlow: erro no workflow\u0027,\n  `Workflow: ${nomeWorkflow}`,\n  `Node: ${nodeFalhou}`,\n  `Erro: ${mensagem}`,\n  `Execução: ${limpar(ex.id || \u0027?\u0027)}`,\n  `Hora: ${hora}`,\n  \u0027Veja em Executions no n8n.\u0027,\n].join(\u0027\\n\u0027);\n\nreturn admins.map((numero) =\u003e ({ json: { numero, texto } }));\n"
                                     },
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
