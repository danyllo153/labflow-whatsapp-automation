{
  "name": "LabFlow claro",
  "dataColors": [
    "#1D6FE8",
    "#0E8A96",
    "#D97706",
    "#7C3AED",
    "#DB2777",
    "#DC2626",
    "#16A34A",
    "#EAB308",
    "#3B5B8C"
  ],
  "foreground": "#0F2547",
  "foregroundNeutralSecondary": "#5B6B85",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F8FD",
  "backgroundNeutral": "#E2E9F4",
  "tableAccent": "#1D6FE8",
  "good": "#16A34A",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#0F2547"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#5B6B85"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#0F2547"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0F2547"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E9F4"
              }
            },
            "radius": 16
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0F2547"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 13,
            "bold": true
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#5B6B85"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E9EEF6"
              }
            },
            "gridlineStyle": "dashed"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": {
              "solid": {
                "color": "#5B6B85"
              }
            },
            "fontSize": 10
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#5B6B85"
              }
            },
            "border": {
              "solid": {
                "color": "#E2E9F4"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF3FB"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EEF3FB"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#F5F8FD"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#5B6B85"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F5F8FD"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#1E2B45"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1E2B45"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E9EEF6"
              }
            },
            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#E2E9F4"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#5B6B85"
              }
            },
            "bold": false
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1E2B45"
              }
            },
            "background": {
              "solid": {
                "color": "#F5F8FD"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E2E9F4"
              }
            }
          }
        ],
        "date": [
          {
            "fontColor": {
              "solid": {
                "color": "#1E2B45"
              }
            },
            "background": {
              "solid": {
                "color": "#F5F8FD"
              }
            }
          }
        ],
        "numericInputStyle": [
          {
            "fontColor": {
              "solid": {
                "color": "#1E2B45"
              }
            },
            "background": {
              "solid": {
                "color": "#F5F8FD"
              }
            }
          }
        ],
        "slider": [
          {
            "color": {
              "solid": {
                "color": "#1D6FE8"
              }
            }
          }
        ]
      }
    }
  }
}