            "background": {
              "solid": {
                "color": "#18181B"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#26262B"
              }
            }
          }
        ],
        "date": [
          {
            "fontColor": {
              "solid": {
                "color": "#E4E4E7"
              }
            },
            "background": {
              "solid": {
                "color": "#18181B"
              }
            }
          }
        ],
        "numericInputStyle": [
          {
            "fontColor": {
              "solid": {
                "color": "#E4E4E7"
              }
            },
            "background": {
              "solid": {
                "color": "#18181B"
              }
            }
          }
        ],
        "slider": [
          {
            "color": {
              "solid": {
                "color": "#3B82F6"
              }
            }
          }
        ]
      }
    }
