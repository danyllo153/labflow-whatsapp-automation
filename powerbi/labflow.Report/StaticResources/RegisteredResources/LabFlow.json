              "solid": {
                "color": "#A1A1AA"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#141416"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#18181B"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#E4E4E7"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E4E4E7"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
