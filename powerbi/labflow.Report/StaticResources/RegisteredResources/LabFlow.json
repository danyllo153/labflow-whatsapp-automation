{
  "name": "LabFlow escuro",
  "dataColors": [
    "#3B82F6",
    "#14B8A6",
    "#F59E0B",
    "#8B5CF6",
    "#EC4899",
    "#EF4444",
    "#22C55E",
    "#EAB308",
    "#94A3B8"
  ],
  "foreground": "#F4F4F5",
  "foregroundNeutralSecondary": "#A1A1AA",
  "background": "#141416",
  "backgroundLight": "#18181B",
  "backgroundNeutral": "#26262B",
  "tableAccent": "#3B82F6",
  "good": "#22C55E",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#F4F4F5"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#A1A1AA"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#F4F4F5"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#F4F4F5"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#141416"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#26262B"
              }
            },
            "radius": 16
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F4F4F5"
              }
