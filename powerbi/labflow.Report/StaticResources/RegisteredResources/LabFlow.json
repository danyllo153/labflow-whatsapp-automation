            "background": {
              "solid": {
                "color": "#141416"
              }
            },
            "fontSize": 13,
            "bold": true
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#A1A1AA"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#71717A"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#27272A"
              }
            },
            "gridlineStyle": "dashed"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": {
              "solid": {
                "color": "#A1A1AA"
              }
