            "foreground": {
              "solid": {
                "color": "#A1A1AA"
              }
            },
            "border": {
              "solid": {
                "color": "#26262B"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0A0A0B"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0A0A0B"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
