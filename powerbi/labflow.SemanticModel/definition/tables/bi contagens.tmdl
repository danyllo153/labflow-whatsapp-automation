	column Embarque = IF('bi contagens'[origem] = "Embarque", 'bi contagens'[navio] & " linha " & 'bi contagens'[linha] & " fase " & 'bi contagens'[fase])
		dataType: string
		lineageTag: 160ffce3-747b-4b45-bafb-4b62e184d576
		summarizeBy: none

	column Faixa = IF('bi contagens'[alarme], "Alarme", IF('bi contagens'[lido], "Normal", "Aguardando"))
		dataType: string
		lineageTag: 87ae0d66-cffc-4fd9-8fcc-dafa4fde8585
		summarizeBy: none

	column 'Data da amostra' = 'bi contagens'[prevista] - SWITCH('bi contagens'[analise], "C.T 48h", 2, "B.L 72h", 3, 5)
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: a02c2c9c-590d-42e2-8598-03afbbe30f17
		summarizeBy: none

	partition 'bi contagens' = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database("localhost:15432", "labflow"),
				    bi_contagens = Fonte{[Schema="bi",Item="contagens"]}[Data]
				in
				    bi_contagens

