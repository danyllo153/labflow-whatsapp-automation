table 'bi desvios'
	lineageTag: 537302f3-3622-476b-9ab0-b6d9aba5a9e9

	measure 'Desvios' = COUNTROWS('bi desvios')
		formatString: 0
		lineageTag: ee95e39c-f8dd-6eb1-6989-f3153bf7240c

	measure 'Desvios abertos' = CALCULATE(COUNTROWS('bi desvios'), 'bi desvios'[status] IN {"Em confirmação", "Em repetição"})
		formatString: 0
		lineageTag: 68d04ec2-eea9-e47b-746d-fe121558f932

	measure 'Desvios confirmados' = CALCULATE(COUNTROWS('bi desvios'), 'bi desvios'[resultado] IN {"Confirmado", "Repetição não ok"})
		formatString: 0
		lineageTag: 5c1c1e44-fbe3-8695-d3c7-e95299ae8c63

	measure 'Desvios não confirmados' = CALCULATE(COUNTROWS('bi desvios'), 'bi desvios'[resultado] IN {"Não confirmado", "Repetição ok"})
		formatString: 0
		lineageTag: 1a4730b9-d269-0ecd-208d-4d96d369c754

	measure 'Confirmou a 7 °C' = CALCULATE(COUNTROWS('bi desvios'), 'bi desvios'[cresceu_7c] = TRUE())
		formatString: 0
		lineageTag: fee59a16-23d0-1311-d461-ca44ac2caf6e

	measure 'Confirmou a 13 °C' = CALCULATE(COUNTROWS('bi desvios'), 'bi desvios'[cresceu_13c] = TRUE())
		formatString: 0
		lineageTag: cdd17372-cb62-d6b8-176b-b7945b39f81a

	measure 'Confirmou a 25 °C' = CALCULATE(COUNTROWS('bi desvios'), 'bi desvios'[cresceu_25c] = TRUE())
		formatString: 0
		lineageTag: 6b1132e2-d912-5706-9b8e-3976c9db121d

	column 'Local' = IF(ISBLANK('bi desvios'[navio]), "Terra (tank farm)", 'bi desvios'[navio])
