table 'bi leituras_nfc'
	lineageTag: af6bf997-5538-4378-bc58-efd35acdcc92

	measure 'Leituras' = COUNTROWS('bi leituras_nfc')
		formatString: 0
		lineageTag: bf181aec-b0c6-49a9-b4bd-e23e43be0d97

	measure 'Leituras lidas' = CALCULATE(COUNTROWS('bi leituras_nfc'), 'bi leituras_nfc'[situacao] = "Lido")
		formatString: 0
		lineageTag: b8596a54-9db4-42dc-82c8-23c70c660d17

	measure 'Leituras atrasadas' = CALCULATE(COUNTROWS('bi leituras_nfc'), 'bi leituras_nfc'[situacao] = "Atrasado")
		formatString: 0
		lineageTag: 74bc0582-4887-4410-8be8-d33225c56867

	measure 'Leituras que vencem hoje' = CALCULATE(COUNTROWS('bi leituras_nfc'), 'bi leituras_nfc'[situacao] = "Vence hoje")
		formatString: 0
		lineageTag: e3bfdd67-df32-4534-b5b5-7c691219a1cd

	measure '% de leituras lidas' = DIVIDE([Leituras lidas], [Leituras])
		formatString: 0%
		lineageTag: 0cd609ca-6668-4750-8b4c-624fbe1098fa

	measure 'HTML andamento das leituras' = VAR linha = SELECTEDVALUE('bi leituras_nfc'[linha_relatorio]) VAR total = COALESCE([Leituras], 0) VAR lidas = COALESCE([Leituras lidas], 0) VAR atras = COALESCE([Leituras atrasadas], 0) VAR hoje = COALESCE([Leituras que vencem hoje], 0) VAR pl = FORMAT(ROUND(DIVIDE(lidas, total, 0) * 100, 0), "0") VAR pa = FORMAT(ROUND(DIVIDE(atras, total, 0) * 100, 0), "0") VAR ph = FORMAT(ROUND(DIVIDE(hoje, total, 0) * 100, 0), "0") RETURN "<div style='margin:2px 6px 14px 6px;font-family:Segoe UI,sans-serif'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:#F4F4F5'><b>" & linha & "</b><span style='font-size:12px;color:#A1A1AA'><b style='color:#22C55E'>" & pl & "% lidas</b> · " & lidas & " de " & total & "</span></div><div style='height:8px;border-radius:6px;background:#27272A;overflow:hidden;display:flex;margin-top:6px'><div style='width:" & pl & "%;background:#22C55E'></div><div style='width:" & pa & "%;background:#EF4444'></div><div style='width:" & ph & "%;background:#F59E0B'></div></div><div style='font-size:11px;margin-top:5px;color:#A1A1AA'><span style='color:#EF4444'>● </span>" & atras & " atrasadas&nbsp;&nbsp;<span style='color:#F59E0B'>● </span>" & hoje & " para hoje</div></div>"
		displayFolder: Painel HTML
		isHidden
		lineageTag: 50beb877-ff7c-46c2-9a53-14f23abfb826

	column 'Local' = IF(ISBLANK('bi leituras_nfc'[navio]), "Terra (tank farm)", 'bi leituras_nfc'[navio])
