table 'bi leituras_nfc'
	lineageTag: af6bf997-5538-4378-bc58-efd35acdcc92

	measure Leituras = COUNTROWS('bi leituras_nfc')
		formatString: 0
		lineageTag: 6a337df8-f0ce-6c16-a1cf-15951a5321c9

	measure 'Leituras lidas' = CALCULATE(COUNTROWS('bi leituras_nfc'), 'bi leituras_nfc'[situacao] = "Lido")
		formatString: 0
		lineageTag: 849ac6b2-fb64-0b75-8541-0193759e81d5

	measure 'Leituras atrasadas' = CALCULATE(COUNTROWS('bi leituras_nfc'), 'bi leituras_nfc'[situacao] = "Atrasado")
		formatString: 0
		lineageTag: 4b23fd51-5be8-4f90-e66e-d26c69153dd6

	measure 'Leituras que vencem hoje' = CALCULATE(COUNTROWS('bi leituras_nfc'), 'bi leituras_nfc'[situacao] = "Vence hoje")
		formatString: 0
		lineageTag: 53b14b5f-b0bf-4866-897b-5f491688bcfe

	measure '% de leituras lidas' = DIVIDE([Leituras lidas], [Leituras])
		formatString: 0%
		lineageTag: d4b20409-9afc-da62-fe25-cd7fe2c9e996

	measure 'HTML andamento das leituras' = VAR linha = SELECTEDVALUE('bi leituras_nfc'[linha_relatorio]) VAR total = COALESCE([Leituras], 0) VAR lidas = COALESCE([Leituras lidas], 0) VAR atras = COALESCE([Leituras atrasadas], 0) VAR hoje = COALESCE([Leituras que vencem hoje], 0) VAR pl = FORMAT(ROUND(DIVIDE(lidas, total, 0) * 100, 0), "0") VAR pa = FORMAT(ROUND(DIVIDE(atras, total, 0) * 100, 0), "0") VAR ph = FORMAT(ROUND(DIVIDE(hoje, total, 0) * 100, 0), "0") RETURN "<div style='margin:2px 6px 14px 6px;font-family:Segoe UI,sans-serif'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:#0F2547'><b>" & linha & "</b><span style='font-size:12px;color:#5B6B85'><b style='color:#16A34A'>" & pl & "% lidas</b> · " & lidas & " de " & total & "</span></div><div style='height:8px;border-radius:6px;background:#E9EEF6;overflow:hidden;display:flex;margin-top:6px'><div style='width:" & pl & "%;background:#16A34A'></div><div style='width:" & pa & "%;background:#DC2626'></div><div style='width:" & ph & "%;background:#D97706'></div></div><div style='font-size:11px;margin-top:5px;color:#5B6B85'><span style='color:#DC2626'>● </span>" & atras & " atrasadas&nbsp;&nbsp;<span style='color:#D97706'>● </span>" & hoje & " para hoje</div></div>"
		isHidden
		displayFolder: Painel HTML
		lineageTag: a80ccfb8-b633-93af-fdea-db239e5ece96

