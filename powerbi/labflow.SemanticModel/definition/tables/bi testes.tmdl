	column 'Resultado ou andamento' = IF(NOT ISBLANK('bi testes'[resultado]), 'bi testes'[resultado], IF('bi testes'[teste] = "Howard", "Concluído", "Em andamento"))
		dataType: string
		lineageTag: 912d947d-4dd0-46fb-acea-6a23bf67154d
		summarizeBy: none

	column Navio = IF('bi testes'[origem] = "Embarque", TRIM(LEFT('bi testes'[embarque], SEARCH(" linha", 'bi testes'[embarque], 1, LEN('bi testes'[embarque]) + 1) - 1)))
		dataType: string
		lineageTag: 955f337f-f5e8-4d6a-8581-b212aab39e83
		summarizeBy: none

	column Identificação = SWITCH('bi testes'[origem], "Tank farm", "Tanque " & 'bi testes'[tanque], "Embarque", 'bi testes'[embarque], "Load " & 'bi testes'[load])
		dataType: string
		lineageTag: 3ed48b4d-1ff5-4983-a56d-4d507e73a5bf
		summarizeBy: none

	partition 'bi testes' = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database("localhost:15432", "labflow"),
				    bi_testes = Fonte{[Schema="bi",Item="testes"]}[Data]
				in
				    bi_testes

	annotation PBI_ResultType = Table

