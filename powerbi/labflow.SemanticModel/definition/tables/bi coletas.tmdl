	measure 'HTML cartões - Visão geral' = "<style>@keyframes lfPulso{0%{opacity:1}50%{opacity:.25}100%{opacity:1}}</style><div style='display:flex;gap:12px;width:100%;height:104px;padding:0 8px 0 0;box-sizing:border-box;font-family:Segoe UI,sans-serif'>" & "<div style='flex:1;min-width:0;position:relative;box-sizing:border-box;border-radius:16px;padding:12px 16px;background:#FFFFFF;border:1px solid #E2E9F4;box-shadow:0 6px 20px rgba(15,37,71,.06)'><div style='position:absolute;top:12px;right:14px;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;background:rgba(220,38,38,0.14);color:#DC2626'>🚨</div><div style='font-size:12px;color:#5B6B85;padding-right:40px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Leituras atrasadas</div><div style='font-size:30px;font-weight:700;color:#0F2547;line-height:1.15;margin:4px 0 6px;letter-spacing:-.5px'>" & FORMAT(COALESCE([Leituras atrasadas], 0), "0") & "</div>" & IF(COALESCE([Leituras atrasadas], 0) > 0, "<span style='display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;color:#DC2626;background:rgba(220,38,38,0.14);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'><span style='width:7px;height:7px;border-radius:50%;background:#DC2626;animation:lfPulso 1.4s infinite'></span>NFC: passaram da data prevista</span>", "<span style='display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;color:#16A34A;background:rgba(22,163,74,0.14);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>✓ Tudo em dia</span>") & "</div>" & "<div style='flex:1;min-width:0;position:relative;box-sizing:border-box;border-radius:16px;padding:12px 16px;background:#FFFFFF;border:1px solid #E2E9F4;box-shadow:0 6px 20px rgba(15,37,71,.06)'><div style='position:absolute;top:12px;right:14px;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;background:rgba(217,119,6,0.14);color:#D97706'>⏰</div><div style='font-size:12px;color:#5B6B85;padding-right:40px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Leituras para hoje</div><div style='font-size:30px;font-weight:700;color:#0F2547;line-height:1.15;margin:4px 0 6px;letter-spacing:-.5px'>" & FORMAT(COALESCE([Leituras que vencem hoje], 0), "0") & "</div>" & IF(COALESCE([Leituras que vencem hoje], 0) > 0, "<span style='display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;color:#D97706;background:rgba(217,119,6,0.14);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'><span style='width:7px;height:7px;border-radius:50%;background:#D97706;animation:lfPulso 1.4s infinite'></span>NFC: ler até o fim do dia</span>", "<span style='display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;color:#16A34A;background:rgba(22,163,74,0.14);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>✓ Nada para hoje</span>") & "</div>" & "<div style='flex:1;min-width:0;position:relative;box-sizing:border-box;border-radius:16px;padding:12px 16px;background:#FFFFFF;border:1px solid #E2E9F4;box-shadow:0 6px 20px rgba(15,37,71,.06)'><div style='position:absolute;top:12px;right:14px;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;background:rgba(220,38,38,0.14);color:#DC2626'>💧</div><div style='font-size:12px;color:#5B6B85;padding-right:40px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Drops atrasados</div><div style='font-size:30px;font-weight:700;color:#0F2547;line-height:1.15;margin:4px 0 6px;letter-spacing:-.5px'>" & FORMAT(COALESCE([Drops atrasados], 0), "0") & "</div>" & IF(COALESCE([Drops atrasados], 0) > 0, "<span style='display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;color:#DC2626;background:rgba(220,38,38,0.14);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'><span style='width:7px;height:7px;border-radius:50%;background:#DC2626;animation:lfPulso 1.4s infinite'></span>D5, D10 e D15 pendentes</span>", "<span style='display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;color:#16A34A;background:rgba(22,163,74,0.14);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>✓ Tudo em dia</span>") & "</div>" & "<div style='flex:1;min-width:0;position:relative;box-sizing:border-box;border-radius:16px;padding:12px 16px;background:#FFFFFF;border:1px solid #E2E9F4;box-shadow:0 6px 20px rgba(15,37,71,.06)'><div style='position:absolute;top:12px;right:14px;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;background:rgba(220,38,38,0.14);color:#DC2626'>🧪</div><div style='font-size:12px;color:#5B6B85;padding-right:40px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>C.T e B.L com alarme</div><div style='font-size:30px;font-weight:700;color:#0F2547;line-height:1.15;margin:4px 0 6px;letter-spacing:-.5px'>" & FORMAT(COALESCE([Resultados com alarme], 0), "0") & "</div>" & IF(COALESCE([Resultados com alarme], 0) > 0, "<span style='display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;color:#DC2626;background:rgba(220,38,38,0.14);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'><span style='width:7px;height:7px;border-radius:50%;background:#DC2626;animation:lfPulso 1.4s infinite'></span>B.L ≥ 50 ou C.T ≥ 200</span>", "<span style='display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;color:#16A34A;background:rgba(22,163,74,0.14);white-space:nowrap;overflow