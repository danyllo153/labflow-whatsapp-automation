	measure 'HTML atrasados por área' = VAR v0 = COALESCE([Leituras atrasadas], 0) VAR v1 = COALESCE([Drops atrasados], 0) VAR v2 = COALESCE([C.T e B.L atrasados], 0) VAR v3 = COALESCE([Testes atrasados], 0) VAR mx = MAX(MAX(MAX(v0, v1), MAX(v2, v3)), 1) RETURN "<div style='font-family:Segoe UI,sans-serif;padding:4px 6px'>" & "<div style='margin-bottom:18px'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:#F4F4F5'><span>Leituras de NFC</span>" & IF(v0 > 0, "<b style='font-size:16px;color:#EF4444'>" & v0 & "</b>", "<span style='font-size:12px;color:#22C55E'>✓ em dia</span>") & "</div><div style='height:10px;border-radius:6px;background:#27272A;margin-top:7px;overflow:hidden'><div style='height:100%;border-radius:6px;width:" & FORMAT(ROUND(DIVIDE(v0, mx) * 100, 0), "0") & "%;background:#EF4444'></div></div></div>" & "<div style='margin-bottom:18px'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:#F4F4F5'><span>Drops</span>" & IF(v1 > 0, "<b style='font-size:16px;color:#F59E0B'>" & v1 & "</b>", "<span style='font-size:12px;color:#22C55E'>✓ em dia</span>") & "</div><div style='height:10px;border-radius:6px;background:#27272A;margin-top:7px;overflow:hidden'><div style='height:100%;border-radius:6px;width:" & FORMAT(ROUND(DIVIDE(v1, mx) * 100, 0), "0") & "%;background:#F59E0B'></div></div></div>" & "<div style='margin-bottom:18px'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:#F4F4F5'><span>C.T e B.L do concentrado</span>" & IF(v2 > 0, "<b style='font-size:16px;color:#14B8A6'>" & v2 & "</b>", "<span style='font-size:12px;color:#22C55E'>✓ em dia</span>") & "</div><div style='height:10px;border-radius:6px;background:#27272A;margin-top:7px;overflow:hidden'><div style='height:100%;border-radius:6px;width:" & FORMAT(ROUND(DIVIDE(v2, mx) * 100, 0), "0") & "%;background:#14B8A6'></div></div></div>" & "<div style='margin-bottom:18px'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:#F4F4F5'><span>TAB e Coliformes</span>" & IF(v3 > 0, "<b style='font-size:16px;color:#8B5CF6'>" & v3 & "</b>", "<span style='font-size:12px;color:#22C55E'>✓ em dia</span>") & "</div><div style='height:10px;border-radius:6px;background:#27272A;margin-top:7px;overflow:hidden'><div style='height:100%;border-radius:6px;width:" & FORMAT(ROUND(DIVIDE(v3, mx) * 100, 0), "0") & "%;background:#8B5CF6'></div></div></div>" & "</div>"
