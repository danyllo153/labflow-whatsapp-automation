	measure 'HTML cartões - Visão geral' = "<style>@keyframes lfPulso{0%{opacity:1}50%{opacity:.25}100%{opacity:1}}</style><div style='display:flex;gap:12px;width:100%;height:104px;padding:0 8px 0 0;box-sizing:border-box;font-family:Segoe UI,sans-serif'>" & "<div style='flex:1;min-width:0;position:relative;box-sizing:border-box;border-radius:16px;padding:12px 16px;background:#141416;border:1px solid #26262B'><div style='position:absolute;top:12px;right:14px;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;background:rgba(239,68,68,0.14);color:#EF4444'>🚨</div><div style='font-size:12px;color:#A1A1AA;padding-right:40px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Leituras atrasadas</div><div style='font-size:30px;font-weight:700;color:#F4F4F5;line-height:1.15;margin:4px 0 6px;letter-spacing:-.5px'>" & FORMAT(COALESCE([Leituras atrasadas], 0), "0") & "</div>" & IF(COALESCE([Leituras atrasadas], 0) > 0, "<span style='display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;color:#EF4444;background:rgba(239,68,68,0.14);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'><span style='width:7px;height:7px;border-radius:50%;background:#EF4444;animation:lfPulso 1.4s infinite'></span>NFC: passaram da data prevista</span>", "<span style='display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;color:#22C55E;background:rgba(34,197,94,0.14);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>✓ Tudo em dia</span>") & "</div>" & "<div style='flex:1;min-width:0;position:relative;box-sizing:border-box;border-radius:16px;padding:12px 16px;background:#141416;border:1px solid #26262B'><div style='position:absolute;top:12px;right:14px;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;background:rgba(