	measure 'HTML atrasados por área' = VAR v0 = COALESCE([Leituras atrasadas], 0) VAR v1 = COALESCE([Drops atrasados], 0) VAR v2 = COALESCE([C.T e B.L atrasados], 0) VAR v3 = COALESCE([Testes atrasados], 0) VAR mx = MAX(MAX(MAX(v0, v1), MAX(v2, v3)), 1) RETURN "<div style='font-family:Segoe UI,sans-serif;padding:4px 6px'>" & "<div style='margin-bottom:18px'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:#0F2547'><span>Leituras de NFC</span>" & IF(v0 > 0, "<b style='font-size:16px;color:#DC2626'>" & v0 & "</b>", "<span style='font-size:12px;color:#16A34A'>✓ em dia</span>") & "</div><div style='height:10px;border-radius:6px;background:#E9EEF6;margin-top:7px;overflow:hidden'><div style='height:100%;border-radius:6px;width:" & FORMAT(ROUND(DIVIDE(v0, mx) * 100, 0), "0") & "%;background:#DC2626'></div></div></div>" & "<div style='margin-bottom:18px'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:#0F2547'><span>Drops</span>" & IF(v1 > 0, "<b style='font-size:16px;color:#D97706'>" & v1 & "</b>", "<span style='font-size:12px;color:#16A34A'>✓ em dia</span>") & "</div><div style='height:10px;border-radius:6px;background:#E9EEF6;margin-top:7px;overflow:hidden'><div style='height:100%;border-radius:6px;width:" & FORMAT(ROUND(DIVIDE(v1, mx) * 100, 0), "0") & "%;background:#D97706'></div></div></div>" & "<div style='margin-bottom:18px'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:#0F2547'><span>C.T e B.L do concentrado</span>" & IF(v2 > 0, "<b style='font-size:16px;color:#0E8A96'>" & v2 & "</b>", "<span style='font-size:12px;color:#16A34A'>✓ em dia</span>") & "</div><div style='height:10px;border-radius:6px;background:#E9EEF6;margin-top:7px;overflow:hidden'><div style='height:100%;border-radius:6px;width:" & FORMAT(ROUND(DIVIDE(v2, mx) * 100, 0), "0") & "%;background:#0E8A96'></div></div></div>" & "<div style='margin-bottom:18px'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:13px;color:#0F2547'><span>TAB e Coliformes</span>" & IF(v3 > 0, "<b style='font-size:16px;color:#7C3AED'>" & v3 & "</b>", "<span style='font-size:12px;color:#16A34A'>✓ em dia</span>") & "</div><div style='height:10px;border-radius:6px;background:#E9EEF6;margin-top:7px;overflow:hidden'><div style='height:100%;border-radius:6px;width:" & FORMAT(ROUND(DIVIDE(v3, mx) * 100, 0), "0") & "%;background:#7C3AED'></div></div></div>" & "</div>"
		displayFolder: Painel HTML
		isHidden
		lineageTag: f3f2ed7a-63d4-4a1b-3611-493a449c1528

