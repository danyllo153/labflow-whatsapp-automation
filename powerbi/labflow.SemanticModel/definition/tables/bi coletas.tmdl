	measure 'HTML cartões - TAB' = "<style>@keyframes lfPulso{0%{opacity:1}50%{opacity:.25}100%{opacity:1}}</style><div style='display:flex;gap:12px;width:100%;height:104px;padding:0 8px 0 0;box-sizing:border-box;font-family:Segoe UI,sans-serif'>" & "<div style='flex:1;min-width:0;position:relative;box-sizing:border-box;border-radius:16px;padding:12px 16px;background:#FFFFFF;border:1px solid #E2E9F4;box-shadow:0 6px 20px rgba(15,37,71,.06)'><div style='position:absolute;top:12px;right:14px;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;background:rgba(29,111,232,0.14);color:#1D6FE8'>🧪</div><div style='font-size:12px;color:#5B6B85;padding-right:40px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>No caldo</div><div style='font-size:30px;font-weight:700;color:#0F2547;line-height:1.15;margin:4px 0 6px;letter-spacing:-.5px'>" & FORMAT(COALESCE([Testes no caldo], 0), "0") & "</div>" & "<span style='display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;color:#1D6FE8;background:rgba(29,111,232,0.14);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Aguardando a próxima etapa</span>" & "</div>" & "<div style='flex:1;min-width:0;position:relative;box-sizing:border-box;border-radius:16px;padding:12px 16px;background:#FFFFFF;border:1px solid #E2E9F4;box-shadow:0 6px 20px rgba(15,37,71,.06)'><div style='position:absolute;top:12px;right:14px;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;background:rgba(124,58,237,0.14);color:#7C3AED'>🌡️</div><div style='font-size:12px;color:#5B6B85;padding-right:40px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Incubados</div><div style='font-size:30px;font-weight:700;color:#0F2547;line-height:1.15;margin:4px 0 6px;letter-spacing:-.5px'>" & FORMAT(COALESCE([Testes incubados], 0), "0") & "</div>" & "<span style='dis