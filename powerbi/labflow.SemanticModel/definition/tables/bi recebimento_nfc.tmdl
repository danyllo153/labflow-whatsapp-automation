table 'bi recebimento_nfc'
	lineageTag: 94689bcb-6a3e-38c6-f5e5-57a9bacffbab

	measure 'NFC lotes' = COUNTROWS(SUMMARIZE('bi recebimento_nfc', 'bi recebimento_nfc'[load], 'bi recebimento_nfc'[lote], 'bi recebimento_nfc'[amostra]))
		formatString: 0
		lineageTag: c6eb5edc-d715-f656-e538-28e3f6ca593e

	measure 'NFC lotes past' = CALCULATE([NFC lotes], 'bi recebimento_nfc'[amostra] = "Pasteurizado")
		formatString: 0
		lineageTag: c765e124-38a1-7a36-afac-7ce56083ffdd

	measure 'NFC lotes fresh' = CALCULATE([NFC lotes], 'bi recebimento_nfc'[amostra] = "Fresh")
		formatString: 0
		lineageTag: ae77ab69-908d-de81-3026-3f118a709c36

	measure 'NFC loads' = DISTINCTCOUNT('bi recebimento_nfc'[load])
		formatString: 0
		lineageTag: d51f3b21-aede-03a2-7ffd-033acc80a9b9

	measure 'NFC resultados lidos' = CALCULATE(COUNTROWS('bi recebimento_nfc'), 'bi recebimento_nfc'[lido] = TRUE())
		formatString: 0
		lineageTag: 7b916f6c-3011-29f7-3b71-a26e4219210a

	measure 'NFC leituras atrasadas' = CALCULATE(COUNTROWS('bi recebimento_nfc'), 'bi recebimento_nfc'[situacao] = "Atrasado")
		formatString: 0
		lineageTag: fa7f0474-9e85-09b3-387e-6e1486d1dbc4

	measure 'NFC resultado final (média)' = AVERAGEX(FILTER('bi recebimento_nfc', 'bi recebimento_nfc'[lido] = TRUE() && 'bi recebimento_nfc'[sinal] = "="), 'bi recebimento_nfc'[valor_final])
		formatString: #,0
		lineageTag: fac50c6b-e18a-4d1f-7543-30f4910e7056

